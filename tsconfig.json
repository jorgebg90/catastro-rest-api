{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "dist",
        "incremental": false,
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": false,
        "skipLibCheck": true,
        "lib": ["ES2023"],
        "types": ["node"]
    },
    "include": ["./src/**/*", "./tests/**/*", "./vitest.config.ts"]
}
